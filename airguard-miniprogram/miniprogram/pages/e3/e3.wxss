/* AirGuard E3 巡检协同页：与首页同款浅色卡片 + 状态色彩风格 */

.container {
  padding: 24rpx 24rpx 40rpx;
}

/* ===== 顶部状态区（渐变横幅，同首页） ===== */
.hero {
  background: linear-gradient(135deg, #1e3a5f, #2c5f8a);
  border-radius: 20rpx;
  padding: 32rpx 30rpx 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 58, 95, 0.25);
}
.hero-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.hero-logo { font-size: 46rpx; }
.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}
.hero-desc {
  font-size: 24rpx;
  color: #bfd9f2;
  margin-bottom: 20rpx;
}
.hero-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.18);
  margin-bottom: 18rpx;
}
.hero-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.status-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #94a3b8;
}
.status-dot.ok { background: #22c55e; }
.status-dot.err { background: #ef4444; }
.hero-status {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.hero-online {
  margin-left: auto;
  color: #bfd9f2;
  font-size: 24rpx;
}

/* ===== 区域切换标签 ===== */
.section-title {
  font-size: 26rpx;
  color: #6b7280;
  margin: 8rpx 0 16rpx;
  font-weight: 600;
}

/* ===== 三区实时状态条（三个区域同屏，每条报文都有可见反应） ===== */
.zone-strip {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.zone-cell {
  flex: 1;
  background: #ffffff;
  border: 2rpx solid #dbe3ec;
  border-radius: 12rpx;
  padding: 14rpx 12rpx;
}
.zone-cell.active {
  border-color: #2563eb;
  box-shadow: 0 0 0 2rpx rgba(37, 99, 235, 0.2);
}
.zc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  margin-bottom: 8rpx;
}
.zc-name {
  font-size: 26rpx;
  font-weight: 600;
}
.zc-tag {
  font-size: 18rpx;
  color: #ffffff;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.zc-metrics {
  font-size: 20rpx;
  color: #6b7280;
  line-height: 1.4;
}
.zone-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.zone-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 16rpx 0;
  border-radius: 999rpx;
  border: 2rpx solid #dbe3ec;
  background: #ffffff;
  color: #6b7280;
}
.zone-tab.active {
  background: #2563eb;
  border-color: #2563eb;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.3);
}

/* ===== 重点区域卡片 ===== */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  border-left: 8rpx solid #9ca3af;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.card-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 18rpx;
}
.card-title { font-size: 32rpx; font-weight: 600; }
.zone-id {
  font-size: 22rpx;
  color: #9ca3af;
  font-family: monospace;
  background: #f3f4f6;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.tag {
  margin-left: auto;
  color: #ffffff;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.metric {
  width: calc(50% - 7rpx);
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}
.m-label {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
}
.m-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}
.m-unit { font-size: 20rpx; font-weight: 400; color: #9ca3af; }
.m-time { font-size: 24rpx; font-weight: 500; }

/* D5 判定行 + 节点状态行 */
.d5-line {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #374151;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}
.d5-line.conflict {
  color: #b45309;
  background: #fff7e6;
  border: 2rpx solid #fcd34d;
  font-weight: 600;
}
.node-line {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6b7280;
}

/* 事件操作按钮 */
.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.op-btn {
  flex: 1;
  font-size: 26rpx;
  border-radius: 12rpx;
}
.op-btn.handle {
  background: #f59e0b;
  color: #ffffff;
}
.op-btn.recover {
  background: #22c55e;
  color: #ffffff;
}
.op-btn.off {
  background: #e5e7eb;
  color: #9ca3af;
}

/* 无数据提示（选中区域尚未收到 MQTT 环境报文） */
.no-data-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #b45309;
  background: #fffbeb;
  border: 2rpx dashed #fcd34d;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  text-align: center;
}
.clear-focus {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #2563eb;
  text-decoration: underline;
}

/* ===== 极简事件列表 ===== */
.ev-card {
  padding: 12rpx 28rpx;
}
.ev-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx dashed #e5e7eb;
  font-size: 24rpx;
  color: #374151;
}
.ev-item:last-child { border-bottom: none; }
.ev-text { flex: 1; line-height: 1.5; }
.chip {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #ffffff;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
}
.chip.d3 { background: #f59e0b; }
.chip.ok { background: #22c55e; }
.ev-empty {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 24rpx 0;
}

/* ===== 底部提示 ===== */
.footer {
  text-align: center;
  font-size: 22rpx;
  color: #b0b8c4;
  padding-top: 8rpx;
}

/* ===== 自诊断行 ===== */
.diag-line {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #2563eb;
  background: #eff6ff;
  border: 2rpx dashed #bfdbfe;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  text-align: center;
}
